{
	"name": "omp-extensions",
	"version": "0.1.0",
	"private": true,
	"description": "Optional extensions marketplace for oh-my-pi (OMP)",
	"license": "MIT",
	"workspaces": ["plugins/*"],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"test": "bun test",
