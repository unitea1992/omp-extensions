		"audit": "bun audit --omit=optional --omit=peer"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@oh-my-pi/pi-coding-agent": "18.3.2",
		"bun-types": "^1.3.0",
		"typescript": "^5.7.0"
	}
}
